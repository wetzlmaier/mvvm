<Window x:Class="WpfApp1.View.UserView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:design="clr-namespace:UserManagement.Design;assembly=UserManagement"
        xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:converter="clr-namespace:Common.Converter;assembly=Common"
        mc:Ignorable="d" 
        Title="User Management" Height="450" Width="700"
        d:DataContext="{d:DesignInstance Type=design:DesignUserViewModel, IsDesignTimeCreatable=True}"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5" Icon="{Binding Icon}">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="5,7"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <converter:DebugConverter x:Key="MyDebugConverter" />

    </Window.Resources>
    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Loaded">
            <b:InvokeCommandAction Command="{Binding ShowUsersViewModel.LoadedCommand}" />
        </b:EventTrigger>
    </b:Interaction.Triggers>
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1.5*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="15" Margin="0,0,15,0" >
            <DockPanel>
                <TextBlock Text="Current Users" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,15" DockPanel.Dock="Top"/>

                <ListView ItemsSource="{Binding ShowUsersViewModel.Users}" BorderThickness="0" AlternationCount="2">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="First Name" DisplayMemberBinding="{Binding FirstName}" Width="150"/>
                            <GridViewColumn Header="Last Name" DisplayMemberBinding="{Binding LastName}" Width="150"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
        </Border>

        <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="20" VerticalAlignment="Top">
            <StackPanel>
                <StackPanel.Resources>
                    <ControlTemplate x:Key="InlineErrorTemplate">
                        <StackPanel>
                            <AdornedElementPlaceholder x:Name="placeholder" />

                            <ContentPresenter Content="{Binding ElementName=placeholder, Path=AdornedElement.(Validation.Errors)[0].ErrorContent}"
                                              TextElement.Foreground="Red"
                                              Margin="0,2,0,0" />
                        </StackPanel>
                    </ControlTemplate>
                </StackPanel.Resources>
                <TextBlock Text="Add New User" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,20"/>

                <TextBlock Text="First Name" Foreground="#555555" Margin="0,0,0,5"/>
                <TextBox x:Name="TextFirstName" Text="{Binding AddUserViewModel.FirstName, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" 
                         Margin="0,0,0,15" Validation.ErrorTemplate="{StaticResource InlineErrorTemplate}"/>

                <TextBlock Text="Last Name" Foreground="#555555" Margin="0,0,0,5"/>
                <TextBox Text="{Binding AddUserViewModel.LastName, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" 
                         ToolTip="{Binding (Validation.Errors)[0].ErrorContent, RelativeSource={RelativeSource Self}}"
                         Margin="0,0,0,25"/>
                <!--<TextBox Text="{Binding LastName, Converter={StaticResource MyDebugConverter}}" Margin="0,0,0,25"/> -->

                <Button Command="{Binding AddUserViewModel.SaveUserCommand}" 
                        Padding="10" 
                        BorderThickness="0"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Content" Value="Save User"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding AddUserViewModel.SaveUserCommand.IsRunning}" Value="True">
                                    <Setter Property="Content" Value="Saving..."/>
                                </DataTrigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.6"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>

